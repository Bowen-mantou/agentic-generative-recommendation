# Agentic Generative Recommendation — environment template
# Copy to .env (gitignored) and fill in. Secrets are only read from the environment,
# never from configs/*.yaml and never written to traces.

# DeepSeek API: Planner / Replanner, Judgment, Recommendation Generator.
DEEPSEEK_API_KEY=sk-replace-me

# Optional.
MEM0_API_KEY=
HF_TOKEN=

# Optional HuggingFace endpoint / mirror.
HF_ENDPOINT=https://hf-mirror.com

# Optional deployment helper (scripts/sync_to_server.py). Never commit real values.
S4000_HOST=
S4000_USER=
S4000_PASSWORD=

# ---- config overrides (rarely needed) ------------------------------------------------
# Any AppConfig field can be overridden with AGR__<SECTION>__<FIELD>.
# AGR_CONFIG_DIR=configs
# AGR__RETRIEVAL__E5__TOP_K_PER_QUERY=50
# AGR__E5__DEVICE=cpu
# AGR__PATHS__RAW_DIR=/tmp/agr/raw
